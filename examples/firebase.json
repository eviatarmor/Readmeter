{
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": [
    {
      "instance": "demo-readmeter",
      "rules": "database.rules.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "demo",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "database": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}
