  "evaluations": ["window"],
  "calls": [
    {
      "service": "functions", "op": "invoke", "name": "coldStart", "ts_ms": 1000, "call_id": 1,
      "duration_us": 3000000, "cold": true, "memory_mb": 256, "response_bytes": 12, "reads": 0
    }
