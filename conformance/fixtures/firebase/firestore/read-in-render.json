{
  "description": "A Feed component calls getDocs on the posts collection in its body (React development build). A state update and a parent re-render make it render three times within 3 seconds, and every render bills the query again.",
  "platform": "browser",
  "evaluations": ["local", "window"],
  "calls": [
    {
      "service": "firestore", "op": "query", "ts_ms": 1000, "call_id": 1, "path": "posts",
      "query": { "limit": 4 },
      "result": { "docs": 4, "bytes": 400 },
      "callsite": "src/Feed.tsx:6:3", "in_render": true
    },
    {
      "service": "firestore", "op": "query", "ts_ms": 2500, "call_id": 2, "path": "posts",
      "query": { "limit": 4 },
      "result": { "docs": 4, "bytes": 400 },
      "callsite": "src/Feed.tsx:6:3", "in_render": true
    },
    {
      "service": "firestore", "op": "query", "ts_ms": 4000, "call_id": 3, "path": "posts",
      "query": { "limit": 4 },
      "result": { "docs": 4, "bytes": 400 },
      "callsite": "src/Feed.tsx:6:3", "in_render": true
    }
  ],
  "expect_envelopes": [
    { "op": "query", "template": "posts", "units": { "reads": 4, "egress_bytes": 400 } },
    { "op": "query", "template": "posts", "units": { "reads": 4, "egress_bytes": 400 } },
    { "op": "query", "template": "posts", "units": { "reads": 4, "egress_bytes": 400 } }
  ],
  "expect_findings": [
    { "rule": "firebase.firestore/read-in-render", "wasted": { "reads": 8 } },
    { "rule": "generic/duplicate-read", "wasted": { "reads": 8, "egress_bytes": 800 } }
  ]
}
