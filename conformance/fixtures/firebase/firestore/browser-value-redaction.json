      "result": { "docs": 2, "bytes": 200 }, "callsite": "src/Owners.tsx:20:5"
    },
    {
      "service": "firestore", "op": "query", "ts_ms": 12100, "call_id": 6, "path": "members",
      "query": { "filters": [{ "field": "ownerId", "op": "==", "value": "Zd5mF1cS4oNr9tV3xA2b" }], "limit": 10 },
      "result": { "docs": 2, "bytes": 200 }, "callsite": "src/Owners.tsx:30:5"
    }
