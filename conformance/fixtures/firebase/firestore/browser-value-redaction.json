{
  "description": "Browser build: three members queries filter role == 'admin', 'owner' and 'guest' (same type and length), then three filter ownerId == a different auto id each. The hash key is visible in the browser, so the role values are reduced to 'string of 5 characters' before hashing: the three role queries share one target key and count as one repeated request. The auto ids are id-shaped and stay distinct.",
  "platform": "browser",
  "evaluations": ["local", "window"],
  "calls": [
    {
      "service": "firestore", "op": "query", "ts_ms": 1000, "call_id": 1, "path": "members",
      "query": { "filters": [{ "field": "role", "op": "==", "value": "admin" }], "limit": 10 },
      "result": { "docs": 2, "bytes": 200 }, "callsite": "src/Roles.tsx:10:5"
    },
    {
      "service": "firestore", "op": "query", "ts_ms": 2700, "call_id": 2, "path": "members",
      "query": { "filters": [{ "field": "role", "op": "==", "value": "owner" }], "limit": 10 },
      "result": { "docs": 2, "bytes": 200 }, "callsite": "src/Roles.tsx:20:5"
    },
    {
      "service": "firestore", "op": "query", "ts_ms": 3100, "call_id": 3, "path": "members",
      "query": { "filters": [{ "field": "role", "op": "==", "value": "guest" }], "limit": 10 },
      "result": { "docs": 2, "bytes": 200 }, "callsite": "src/Roles.tsx:30:5"
    },
    {
      "service": "firestore", "op": "query", "ts_ms": 10000, "call_id": 4, "path": "members",
      "query": { "filters": [{ "field": "ownerId", "op": "==", "value": "Xb3kD9aQ2mLp7rT1vY0z" }], "limit": 10 },
      "result": { "docs": 2, "bytes": 200 }, "callsite": "src/Owners.tsx:10:5"
    },
    {
