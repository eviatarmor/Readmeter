{
  "name": "@readmeter/firebase",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "wasm",
    "bundle",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./firestore": {
      "types": "./dist/web/firestore.d.ts",
      "import": "./dist/web/firestore.js"
    },
    "./database": {
      "types": "./dist/web/database.d.ts",
      "import": "./dist/web/database.js"
    },
    "./storage": {
      "types": "./dist/web/storage.d.ts",
      "import": "./dist/web/storage.js"
    },
    "./auth": {
      "types": "./dist/web/auth.d.ts",
      "import": "./dist/web/auth.js"
    },
    "./functions": {
      "types": "./dist/web/functions.d.ts",
      "import": "./dist/web/functions.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./callsite": {
      "types": "./dist/callsite.d.ts",
      "import": "./dist/callsite.js"
    },
    "./vite": {
      "types": "./dist/plugin/vite.d.ts",
      "import": "./dist/plugin/vite.js"
    },
    "./webpack-loader": {
      "types": "./dist/plugin/webpack-loader.d.ts",
      "import": "./dist/plugin/webpack-loader.js"
    },
    "./wasm/prod/readmeter_wasm_bg.wasm": "./wasm/prod/readmeter_wasm_bg.wasm",
    "./wasm/dev/readmeter_wasm_bg.wasm": "./wasm/dev/readmeter_wasm_bg.wasm"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:bundle": "vite build --config test/bundle/vite.config.ts && node test/bundle/check.mjs && vite build --config test/bundle/app/vite.config.ts && node test/bundle/app/check.mjs",
    "test:emulator": "bash scripts/emulator-test.sh"
  },
  "peerDependencies": {
    "@babel/parser": ">=7.20",
    "@google-cloud/firestore": ">=7",
    "@google-cloud/storage": ">=8",
    "firebase": ">=10 <13",
    "firebase-admin": ">=12",
    "magic-string": ">=0.30"
  },
  "peerDependenciesMeta": {
    "@babel/parser": {
      "optional": true
    },
    "magic-string": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "@google-cloud/firestore": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@readmeter/db": "workspace:*",
    "@types/node": "^24",
    "magic-string": "^0.30.21",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "webpack": "^5.111.1"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eviatarmor/Readmeter.git",
    "directory": "sdks/js/firebase"
  },
  "description": "Find Firestore, Realtime Database, Cloud Storage, Authentication, and Cloud Functions cost problems in Firebase web apps and Cloud Functions, down to the callsite.",
  "publishConfig": {
    "access": "public"
  }
}
