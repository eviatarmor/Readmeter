{
  "name": "@readmeter/db",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "retention": "tsx src/retention-cli.ts",
    "seed": "tsx src/seed.ts && pnpm --filter @readmeter/console-api exec tsx src/seed-user.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "kysely": "^0.29.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
