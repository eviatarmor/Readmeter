# Copy to deploy/.env. Choose a URL-safe password (letters/digits work).
POSTGRES_PASSWORD=
# Generate each secret independently: openssl rand -base64 32
BETTER_AUTH_SECRET=
READMETER_SECRET_KEY=

# Pin a release for production, e.g. ghcr.io/eviatarmor/readmeter:0.1.0
READMETER_IMAGE=ghcr.io/eviatarmor/readmeter:latest
CONSOLE_ORIGIN=http://localhost:8091
INGEST_PUBLIC_URL=http://localhost:8090
# Bind locally behind a TLS reverse proxy. Set 0.0.0.0 for remote access.
CONSOLE_BIND=127.0.0.1
INGEST_BIND=127.0.0.1
CONSOLE_PORT=8091
INGEST_PORT=8090

# Optional: sign rule bundles served to SDKs (Ed25519 seed, base64).
# Generate with: docker run --rm ghcr.io/eviatarmor/readmeter bundle-keygen
READMETER_BUNDLE_SIGNING_KEY=

# Optional email and Google sign-in.
SMTP_URL=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
